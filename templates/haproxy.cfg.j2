# HAProxy Configuration - Generated by Ansible
# Role: ansible_deploy_haproxy

#---------------------------------------------------------------------
# Global settings
#---------------------------------------------------------------------
global
    log         {{ haproxy_global_log }}
    chroot      {{ haproxy_global_chroot }}
    pidfile     {{ haproxy_global_pidfile }}
    maxconn     {{ haproxy_global_maxconn }}
    user        {{ haproxy_global_user }}
    group       {{ haproxy_global_group }}
{% if haproxy_global_daemon %}
    daemon
{% endif %}

    # turn on stats unix socket
    stats socket {{ haproxy_global_stats_socket }} mode 660 level admin

    # utilize system-wide crypto-policies
    ssl-default-bind-ciphers {{ haproxy_global_ssl_default_bind_ciphers }}
    ssl-default-bind-options {{ haproxy_global_ssl_default_bind_options }}

#---------------------------------------------------------------------
# Defaults settings
#---------------------------------------------------------------------
defaults
    mode                    {{ haproxy_defaults_mode }}
    log                     {{ haproxy_defaults_log }}
{% if haproxy_defaults_option is defined %}
{% for option in haproxy_defaults_option %}
    option                  {{ option }}
{% endfor %}
{% endif %}
    timeout connect         {{ haproxy_defaults_timeout_connect }}
    timeout client          {{ haproxy_defaults_timeout_client }}
    timeout server          {{ haproxy_defaults_timeout_server }}
    timeout http-request    {{ haproxy_defaults_timeout_http_request }}
    timeout queue           {{ haproxy_defaults_timeout_queue }}
    timeout http-keep-alive {{ haproxy_defaults_timeout_http_keep_alive }}
    timeout check           {{ haproxy_defaults_timeout_check }}
    maxconn                 {{ haproxy_defaults_maxconn }}

#---------------------------------------------------------------------
# Frontends configuration
#---------------------------------------------------------------------
{% for frontend in haproxy_frontends %}
frontend {{ frontend.name }}
    bind {{ frontend.bind }}
{% if frontend.mode is defined %}
    mode {{ frontend.mode }}
{% endif %}
{% if frontend.options is defined %}
{% for option in frontend.options %}
    option {{ option }}
{% endfor %}
{% endif %}
{% if frontend.acls is defined %}
{% for acl in frontend.acls %}
    acl {{ acl }}
{% endfor %}
{% endif %}
{% if frontend.use_backend is defined %}
{% for backend_rule in frontend.use_backend %}
    use_backend {{ backend_rule }}
{% endfor %}
{% endif %}
{% if frontend.default_backend is defined %}
    default_backend {{ frontend.default_backend }}
{% endif %}

{% endfor %}
#---------------------------------------------------------------------
# Backends configuration
#---------------------------------------------------------------------
{% for backend in haproxy_backends %}
backend {{ backend.name }}
{% if backend.mode is defined %}
    mode {{ backend.mode }}
{% endif %}
{% if backend.balance is defined %}
    balance {{ backend.balance }}
{% endif %}
{% if backend.options is defined %}
{% for option in backend.options %}
    option {{ option }}
{% endfor %}
{% endif %}
{% if backend.http_request is defined %}
{% for request in backend.http_request %}
    http-request {{ request }}
{% endfor %}
{% endif %}
{% if backend.servers is defined %}
{% for server in backend.servers %}
    server {{ server.name }} {{ server.address }}
{%- if server.check is defined and server.check %} check{% endif %}
{%- if server.backup is defined and server.backup %} backup{% endif %}
{%- if server.extra_params is defined %} {{ server.extra_params }}{% endif %}

{% endfor %}
{% endif %}

{% endfor %}
#---------------------------------------------------------------------
# Stats page configuration
#---------------------------------------------------------------------
{% if haproxy_stats_enable %}
listen stats
    bind *:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri {{ haproxy_stats_uri }}
    stats realm {{ haproxy_stats_realm }}
    stats auth {{ haproxy_stats_auth }}
{% endif %}
